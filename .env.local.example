# Copie este arquivo para .env.local e preencha com os dados do seu
# projeto Supabase (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — NUNCA expor no cliente. Usada só no servidor
# (Server Action) para criar contas de motoboy via Auth Admin API.
SUPABASE_SERVICE_ROLE_KEY=
